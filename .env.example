# shop 단독몰 — 환경 변수 예시
# 본 파일을 .env 로 복사 후 실제 값 입력하십시오 (.env 는 git 제외).

# ─── Postgres (Docker shop-postgres 컨테이너) ─────────────────────────
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_local_2026

# ─── Redis (Docker shop-redis 컨테이너) ───────────────────────────────
# (Redis URL 은 apps/medusa/.env 에서 별도 관리)

# ─── 메두사 백엔드 (apps/medusa) ──────────────────────────────────────
DATABASE_URL=postgres://shop:shop_local_2026@127.0.0.1:5434/shop
REDIS_URL=redis://127.0.0.1:6381
JWT_SECRET=please-change-this-jwt-secret-for-prod
COOKIE_SECRET=please-change-this-cookie-secret-for-prod
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:8000

# ─── 스토어프론트 ISR revalidate 배선 (d4 카테고리 캐시 무효화) ───────
# 백엔드 subscriber(storefront-revalidate.ts) → 스토어프론트 POST /api/revalidate.
# STOREFRONT_URL 미설정 시 subscriber 가 revalidate 를 건너뜀(안전).
# REVALIDATE_SECRET 은 백엔드·스토어프론트 양쪽에 동일 값으로 설정해야 매칭됨.
# 계약 단일 출처: backend/.../subscribers/revalidate-contract.ts
#                apps/web/src/lib/data/revalidate-tags.ts
STOREFRONT_URL=http://localhost:8000
# TODO(정책/시크릿): 운영 배포 전 강력한 무작위 토큰으로 교체. 미설정 시 비인증 경고만 출력.
REVALIDATE_SECRET=please-change-this-revalidate-secret-for-prod

# ─── 브랜딩 (메두사 단어 일괄 교체용) ─────────────────────────────────
APP_NAME=shop
APP_NAME_KO=쇼핑몰

# ─── Admin 자동 로그인 (로컬 전용 — 운영 절대 금지) ───────────────────
ADMIN_EMAIL=admin
ADMIN_PASSWORD=djemalsdlqslek12!@

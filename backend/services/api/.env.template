# ═══════════════════════════════════════════════════════════════════════════
#  백엔드 환경변수 템플릿
#
#  2026-08-03 전면 점검: 코드가 실제로 읽는 변수 25개 중 19개가 이 파일에 없었다.
#  누락된 변수는 운영에서 "조용히 기본값"으로 동작하므로, 여기에 전부 적어 둔다.
#  (실제로 무엇을 읽는지: `grep -rn "process.env\." src medusa-config.ts`)
#
#  표기: [필수] 없으면 동작 불가 · [운영필수] 개발은 폴백, 운영은 반드시 지정
#        [선택] 없으면 명시된 기본값
# ═══════════════════════════════════════════════════════════════════════════

# ─── 기본 ────────────────────────────────────────────────────────────────
# [필수] Postgres 접속 문자열
DATABASE_URL=
DB_NAME=medusa-backend
# [선택] production 이면 여러 보안 검사가 fail-fast 로 바뀐다(아래 암호화 키 참조)
NODE_ENV=development

# ─── CORS (allowlist, 와일드카드 금지) ───────────────────────────────────
# [필수] 미설정 시 undefined 로 넘어가 의도치 않은 동작이 될 수 있다.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:7002
AUTH_CORS=http://localhost:8000,http://localhost:9000,http://localhost:7002

# ─── 시크릿 ──────────────────────────────────────────────────────────────
# [필수] 환경별 고유 무작위 값으로 교체(`openssl rand -base64 48`). 절대 커밋 금지.
JWT_SECRET=CHANGE_ME_32BYTES_RANDOM
COOKIE_SECRET=CHANGE_ME_32BYTES_RANDOM
# [선택] 액세스 토큰 수명. 기본은 Medusa 기본값.
JWT_EXPIRES_IN=1d
# [운영필수] HTTPS 환경에서는 반드시 true — 세션 쿠키에 Secure 플래그를 붙인다.
COOKIE_SECURE=false

# ─── 프록시 뒤 배포 시 요청자 IP 판별 ─────────────────────────────────────
# 앱 앞에 있는 **신뢰 가능한** 프록시(ALB·CloudFront·Nginx) 대수.
#   0 (기본)  X-Forwarded-For 를 무시하고 소켓 주소만 쓴다 — 로컬·프록시 없는 배포
#   1         LB 또는 리버스프록시 한 대 뒤  ← 가장 흔한 운영 구성
#   2         CDN + LB 두 단 뒤
#
# ⚠️ 이 값이 0 이면 프록시 뒤에서 모든 요청이 LB 아이피 하나로 잡혀
#    레이트리밋이 전체 사용자에게 공유된다. 배포 형태에 맞게 반드시 설정할 것.
# ⚠️ 실제보다 크게 잡으면 요청자가 위조한 값을 읽게 된다. 모르면 0 으로 둔다.
#
# 배경: 2026-08-04 점검에서 XFF 맨 앞 값을 신뢰해 레이트리밋이 우회되는 것을 실측 확인
#       (비회원 주문조회 39/40 통과). 신뢰 홉 기준으로 오른쪽에서 읽도록 바꿨다.
TRUSTED_PROXY_HOPS=0

# ─── 스토어프론트가 대신 알려주는 고객 IP ────────────────────────────────
# 스토어프론트의 데이터 계층은 Next.js 서버 액션이라, 로그인·리뷰·주문조회가
# 고객 브라우저가 아니라 **스토어프론트 서버에서** 백엔드로 나온다.
# 그래서 백엔드는 모든 고객을 서버 한 대로 보게 되고, IP 레이트리밋이
# 고객별이 아니라 쇼핑몰 전체 합산으로 걸린다.
#
# 실측(2026-08-04): 서로 다른 고객 10명이 비밀번호를 틀리자 11번째 고객까지
#                   429 를 받았다 — 쇼핑몰 전체 5분 로그인 불가.
#
# 아래 시크릿을 **스토어프론트와 같은 값**으로 넣으면, 스토어프론트가 확인한
# 고객 IP 를 서명과 함께 전달하고 백엔드가 그걸 버킷 키로 쓴다.
# 비워두면 이 경로는 비활성(기존 동작)이다.
#   openssl rand -base64 32
INTERNAL_CLIENT_IP_SECRET=

# ─── at-rest 암호화 키 ───────────────────────────────────────────────────
# 둘 다 NODE_ENV=production 이면 **미설정 시 부팅/사용 실패(fail-fast)** 한다.
# 개발에서는 COOKIE_SECRET 으로 폴백하며 경고만 남는다.
# 운영은 KMS/Secrets Manager 로 주입하고 로테이션 정책을 세울 것.
# [운영필수] 세금계산서 등 PII at-rest 암호화(AES-256-GCM)
PII_ENCRYPTION_KEY=
# [운영필수] 관리자 2FA 시크릿 at-rest 암호화
ADMIN_2FA_SECRET_KEY=

# ─── Redis / 분산 락 ─────────────────────────────────────────────────────
# [운영필수] 캐시·이벤트버스·레이트리밋 저장소.
REDIS_URL=redis://localhost:6379
# [운영필수] 금전 임계구역(적립금 사용)의 분산 락 저장소. 미지정 시 REDIS_URL 로 폴백.
#
#  ⚠️ 둘 다 없으면 락 provider 가 **in-memory** 로 떨어진다. 프로세스 단위로만 유효하므로
#     API 인스턴스를 2대 이상 띄우면 락이 무력화되고 **적립금 이중 사용이 다시 가능해진다.**
#     (2026-08-03 실측: 락이 없을 때 10,000P 로 30,000원 할인, 잔액 -20,000P)
LOCKING_REDIS_URL=

# ─── 보안 강화 플래그 (opt-in) ───────────────────────────────────────────
# 개발은 OFF 유지, **운영은 3개 모두 true 권장**.
# [선택/기본 false] 가드 내부 오류 시 통과(fail-open) 대신 503 으로 차단(fail-closed)
SECURITY_GUARD_FAIL_CLOSED=false
# [선택/기본 false] 2FA 미등록 관리자의 쓰기 작업 차단
ADMIN_2FA_REQUIRED=false
# [선택/기본 false] 환불·취소 등 금전 액션을 super 등급 전용으로 제한
ADMIN_MONEY_ACTIONS_SUPER_ONLY=false
# [선택/기본 3600] 로그아웃 토큰 denylist 보관 시간(초). 토큰 수명 이상으로 둘 것.
JWT_DENYLIST_TTL_SEC=3600

# ─── 적립금 정책 ─────────────────────────────────────────────────────────
# [선택/기본 false] 적립금 할인의 과세 기준.
#   false = 공급가(pre-tax)에 적용 → 1,000P 사용 시 결제액이 1,100원 줄어든다(부가세만큼 초과 혜택)
#   true  = 최종 결제액 기준 → 1,000P 사용 시 정확히 1,000원 감소
#   ※ 회계/세무 확인 후 결정할 것.
POINTS_DISCOUNT_POST_TAX=false

# ─── 휴면계정 ────────────────────────────────────────────────────────────
# [선택/기본 365] 미접속 N일 경과 시 휴면 전환
DORMANCY_DAYS=365
# [선택/기본 30] 휴면 전환 N일 전 사전 안내
DORMANCY_WARN_DAYS=30

# ─── 스토어프론트 ISR revalidate (계약: src/subscribers/revalidate-contract.ts) ───
# [운영필수] 미설정 시 subscriber 가 revalidate 를 건너뛴다(카탈로그 변경이 화면에 안 뜸).
STOREFRONT_URL=http://localhost:8000
# [운영필수] 스토어프론트(apps/web)의 REVALIDATE_SECRET 과 동일 값이어야 한다.
#            운영 전 무작위 토큰으로 교체할 것.
REVALIDATE_SECRET=CHANGE_ME_RANDOM_TOKEN

# ─── 스토어 표시명 (scripts/set-store-name.ts) ───────────────────────────
APP_NAME=Shop
APP_NAME_KO=쇼핑몰

# ─── 시드/운영 스크립트 전용 (서버 런타임 아님) ─────────────────────────
# seed-all.ts 가 만드는 초기 관리자 계정. **운영 데이터에는 사용하지 말 것.**
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=CHANGE_ME
# cleanup-test-data.ts — 기본은 미리보기(dry-run). true 로만 실제 반영.
CLEANUP_APPLY=false
CLEANUP_RENAME_TEST_CATEGORIES=false
# backfill-pii-encryption.ts — 기본은 dry-run.
PII_BACKFILL_DRY_RUN=true

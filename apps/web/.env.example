# 스토어프론트(apps/web) 환경변수 템플릿
# 사용법: 이 파일을 `.env.local` 로 복사한 뒤 값을 채우세요. (.env.local 은 git 비추적)

# Medusa 백엔드(:9000) 주소
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# 퍼블리셔블 API 키 — 관리자 > 설정 > Publishable API Keys 에서 발급한 값
# 모든 /store 호출에 필수. (pk_ 로 시작)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_change_me

# 기본 리전(국가코드). 국내 기반이면 kr
NEXT_PUBLIC_DEFAULT_REGION=kr

# 스토어프론트 자기 주소(절대 URL 생성용)
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# 브랜드 표기
NEXT_PUBLIC_APP_NAME=shop
NEXT_PUBLIC_APP_NAME_KO=쇼핑몰

# 백엔드 → 스토어프론트 캐시 무효화(revalidate) 호출 시 공유 시크릿
REVALIDATE_SECRET=change-me

# ── 전자상거래법 필수 표기(운영 배포 전 반드시 채울 것) ───────────────────
# 미설정 시 화면에 예시값 + 경고 문구가 노출된다.
NEXT_PUBLIC_BIZ_NAME=쇼핑몰
NEXT_PUBLIC_BIZ_CEO=대표자명
NEXT_PUBLIC_BIZ_REG_NO=000-00-00000
NEXT_PUBLIC_BIZ_MAIL_ORDER_NO=2026-서울강남-00000
NEXT_PUBLIC_BIZ_ADDRESS=서울특별시 ...
NEXT_PUBLIC_BIZ_PRIVACY_OFFICER=담당자명(privacy@example.com)

# 고객센터 표기
NEXT_PUBLIC_CS_PHONE=1600-0000
NEXT_PUBLIC_CS_HOURS=평일 10:00–18:00 (점심 12:00–13:00)
NEXT_PUBLIC_CS_EMAIL=help@example.com

# ─── 선택: 외부 유료 연동 (2026-08-03 문서화) ─────────────────────────────
# 코드가 참조하지만 템플릿에 없던 변수들. 미설정이면 해당 기능이 비활성일 뿐 동작에 지장 없다.
# 실제 연동은 계약·비용이 발생하므로 현재 범위 밖이다.
#
# 결제(Stripe / Medusa Payments) — 미설정 시 결제 위젯 비활성
# NEXT_PUBLIC_STRIPE_KEY=
# NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
# NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=
#
# 오류 모니터링(Sentry) — 미설정 시 리포팅 비활성
# NEXT_PUBLIC_SENTRY_DSN=

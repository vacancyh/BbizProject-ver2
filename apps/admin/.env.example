# 관리자 앱(apps/admin) 환경변수 템플릿
# 사용법: 이 파일을 `.env.local` 로 복사한 뒤 값을 채우세요. (.env.local 은 git 비추적)

# 호스트에서 직접 실행하는 Medusa 백엔드(:9000) 주소
NEXT_PUBLIC_BACKEND_URL=http://localhost:9000

# (선택·개발 전용) 로그인 폼 자동 프리필 값.
# 운영 빌드(NODE_ENV=production)에서는 코드상 분기가 제거되어 사용되지 않는다.
# 운영 환경에는 절대 설정하지 말 것.
# NEXT_PUBLIC_DEV_ADMIN_EMAIL=admin@shop.local
# NEXT_PUBLIC_DEV_ADMIN_PASSWORD=admin1234!

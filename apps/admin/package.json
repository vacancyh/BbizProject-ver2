    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.18",
    "junit-xml": "^1.2.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",

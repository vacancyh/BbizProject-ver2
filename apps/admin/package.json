{
  "name": "@shop/admin",
  "version": "0.1.0",
  "private": true,
  "description": "shop 어드민 리플랫폼 — Medusa 백엔드 기준 한국형 관리자 앱 (Next.js)",
  "scripts": {
    "dev": "next dev -p 7002",
    "build": "next build",
    "start": "next start -p 7002",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
